  "info": {
    "title": "OpenJobSeekR API",
    "description": "Local job application tracker. Errors use { code, message, details? }.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "At most 72 bytes (UTF-8)"
          }
        },
        "required": ["email", "password"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "email", "createdAt"]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token, sent as `Authorization: Bearer <token>`"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": ["accessToken", "user"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "CreateApplicationDto": {
        "type": "object",
        "properties": {
          "sentAt": {
            "type": "string",
            "example": "2026-10-01",
            "description": "YYYY-MM-DD"
          },
          "company": {
            "type": "string",
            "maxLength": 200
          },
          "jobTitle": {
            "type": "string",
            "maxLength": 200
          },
          "location": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "response": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "resources": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "channel": {
            "type": "string",
            "enum": [
              "CAREER_SITE",
              "LINKEDIN",
              "WELCOME_TO_THE_JUNGLE",
              "HELLOWORK",
              "APEC",
              "RECRUITMENT_AGENCY",
              "UNSOLICITED",
              "REFERRAL",
              "OTHER"
            ],
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "RESPONSE_RECEIVED",
              "HR_INTERVIEW",
              "TECHNICAL_INTERVIEW",
              "OFFER",
              "REJECTED",
              "NO_RESPONSE"
            ],
            "default": "SENT"
          },
          "contact": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "workMode": {
            "type": "string",
            "enum": ["ONSITE", "HYBRID", "FULL_REMOTE", "UNSPECIFIED"],
            "nullable": true
          },
          "remoteRhythm": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "salaryRange": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "cvVersion": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "stack": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "recruitmentProcess": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          },
          "jobPostingText": {
            "type": "string",
            "nullable": true,
            "maxLength": 50000
          }
        },
        "required": ["sentAt", "company", "jobTitle"]
      },
      "ApplicationDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sentAt": {
            "type": "string",
            "example": "2026-10-01"
          },
          "company": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          },
          "location": {
            "type": "string",
            "nullable": true
          },
          "response": {
            "type": "string",
            "nullable": true
          },
          "resources": {
            "type": "string",
            "nullable": true
          },
          "channel": {
            "type": "string",
            "enum": [
              "CAREER_SITE",
              "LINKEDIN",
              "WELCOME_TO_THE_JUNGLE",
              "HELLOWORK",
              "APEC",
              "RECRUITMENT_AGENCY",
              "UNSOLICITED",
              "REFERRAL",
              "OTHER"
            ],
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "RESPONSE_RECEIVED",
              "HR_INTERVIEW",
              "TECHNICAL_INTERVIEW",
              "OFFER",
              "REJECTED",
              "NO_RESPONSE"
            ]
          },
          "contact": {
            "type": "string",
            "nullable": true
          },
          "followUpDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-08",
            "description": "Computed: sentAt + follow-up delay while the status is SENT"
          },
          "followUpOverdue": {
            "type": "boolean",
            "description": "Computed: true when today is after followUpDate"
          },
          "workMode": {
            "type": "string",
            "enum": ["ONSITE", "HYBRID", "FULL_REMOTE", "UNSPECIFIED"],
            "nullable": true
          },
          "remoteRhythm": {
            "type": "string",
            "nullable": true
          },
          "salaryRange": {
            "type": "string",
            "nullable": true
          },
          "cvVersion": {
            "type": "string",
            "nullable": true
          },
          "stack": {
            "type": "string",
            "nullable": true
          },
          "recruitmentProcess": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "jobPostingText": {
            "type": "string",
            "nullable": true,
            "description": "Only in the detail response"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sentAt",
          "company",
          "jobTitle",
          "location",
          "response",
          "resources",
          "channel",
          "status",
          "contact",
          "followUpDate",
          "followUpOverdue",
          "workMode",
          "remoteRhythm",
          "salaryRange",
          "cvVersion",
          "stack",
          "recruitmentProcess",
          "notes",
          "jobPostingText",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApplicationSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sentAt": {
            "type": "string",
