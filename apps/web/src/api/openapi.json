            "description": "VALIDATION_FAILED"
          },
          "401": {
            "description": "UNAUTHORIZED"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List applications (without the job posting text), newest first",
        "tags": ["applications"]
      }
