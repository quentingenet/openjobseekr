          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "RESPONSE_RECEIVED",
              "HR_INTERVIEW",
              "TECHNICAL_INTERVIEW",
              "OFFER",
              "REJECTED",
              "NO_RESPONSE"
            ]
          },
          "contact": {
            "type": "string",
            "nullable": true
          },
          "followUpDate": {
            "type": "string",
            "nullable": true,
            "example": "2026-10-08",
            "description": "Computed: sentAt + follow-up delay while the status is SENT"
          },
          "followUpOverdue": {
            "type": "boolean",
            "description": "Computed: true when today is after followUpDate"
          },
          "workMode": {
            "type": "string",
            "enum": ["ONSITE", "HYBRID", "FULL_REMOTE", "UNSPECIFIED"],
            "nullable": true
          },
          "remoteRhythm": {
            "type": "string",
            "nullable": true
          },
          "salaryRange": {
            "type": "string",
            "nullable": true
          },
          "cvVersion": {
            "type": "string",
            "nullable": true
          },
          "stack": {
            "type": "string",
            "nullable": true
          },
          "recruitmentProcess": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "sentAt",
          "company",
          "jobTitle",
          "location",
          "response",
          "resources",
          "channel",
          "status",
          "contact",
          "followUpDate",
          "followUpOverdue",
          "workMode",
          "remoteRhythm",
          "salaryRange",
          "cvVersion",
          "stack",
          "recruitmentProcess",
          "notes",
          "createdAt",
          "updatedAt"
        ]
      },
      "ApplicationListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApplicationSummaryDto"
            }
          },
          "total": {
            "type": "number",
            "description": "Number of applications matching the filters"
          },
          "limit": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          }
        },
        "required": ["items", "total", "limit", "offset"]
      },
      "UpdateApplicationDto": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "response": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "resources": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "channel": {
            "type": "string",
            "enum": [
              "CAREER_SITE",
              "LINKEDIN",
              "WELCOME_TO_THE_JUNGLE",
              "HELLOWORK",
              "APEC",
              "RECRUITMENT_AGENCY",
              "UNSOLICITED",
              "REFERRAL",
              "OTHER"
            ],
            "nullable": true
          },
          "contact": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "workMode": {
            "type": "string",
            "enum": ["ONSITE", "HYBRID", "FULL_REMOTE", "UNSPECIFIED"],
            "nullable": true
          },
          "remoteRhythm": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "salaryRange": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "cvVersion": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "stack": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          },
          "recruitmentProcess": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 10000
          },
          "jobPostingText": {
            "type": "string",
            "nullable": true,
            "maxLength": 50000
          },
          "sentAt": {
            "type": "string",
            "example": "2026-10-01",
            "description": "YYYY-MM-DD"
          },
          "company": {
            "type": "string",
            "maxLength": 200
          },
          "jobTitle": {
            "type": "string",
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "SENT",
              "RESPONSE_RECEIVED",
              "HR_INTERVIEW",
              "TECHNICAL_INTERVIEW",
              "OFFER",
              "REJECTED",
              "NO_RESPONSE"
            ]
          }
        }
      },
      "StatsOverviewDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number"
          },
          "byStatus": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Count per status code; every code is present",
            "example": {
              "SENT": 4,
              "HR_INTERVIEW": 1,
              "REJECTED": 1
            }
          },
          "byChannel": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Count per channel code; UNSPECIFIED counts applications without a channel",
            "example": {
              "LINKEDIN": 3,
              "APEC": 2,
              "UNSPECIFIED": 1
            }
          },
          "responseRate": {
            "type": "number",
            "nullable": true,
            "description": "Responses / total (not rounded); null without applications"
          }
        },
        "required": ["total", "byStatus", "byChannel", "responseRate"]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "followUpDelayDays": {
            "type": "number",
            "example": 7,
            "description": "Days between sending an application and following up"
          }
        },
        "required": ["followUpDelayDays"]
      }
    }
  }
}
