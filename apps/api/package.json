{
  "name": "@openjobseekr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "prisma generate",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "openapi:export": "nest build && node dist/export-openapi.js ../web/src/api/openapi.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "re2": "^1.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
