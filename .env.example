# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=openjobseekr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openjobseekr

# Development database (docker service `db`)
DATABASE_URL=postgresql://openjobseekr:change-me@localhost:5432/openjobseekr
# End-to-end test database (docker service `db-test`)
DATABASE_URL_TEST=postgresql://openjobseekr:change-me@localhost:5433/openjobseekr_test

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Business rules
FOLLOW_UP_DELAY_DAYS=7

# API
PORT=3000
