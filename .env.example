# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=openjobseekr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openjobseekr

# Development database
DATABASE_URL=postgresql://openjobseekr:change-me@localhost:5432/openjobseekr
# End-to-end test database (emptied by the e2e tests).
# Local PostgreSQL: port 5432. Docker Compose service `db-test`: port 5433.
DATABASE_URL_TEST=postgresql://openjobseekr:change-me@localhost:5432/openjobseekr_test

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Business rules
FOLLOW_UP_DELAY_DAYS=7
# Login and registration attempts per minute and per IP address
AUTH_RATE_LIMIT=5

# API
PORT=3000
